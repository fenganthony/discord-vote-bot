{
  "name": "discord-vote-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless Discord 投票機器人（Cloudflare Workers + D1 + Durable Objects）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply discord-vote-bot --local",
    "db:migrate": "wrangler d1 migrations apply discord-vote-bot --remote",
    "register": "node scripts/register.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
